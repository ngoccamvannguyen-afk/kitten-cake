{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": "{style.css,app.js,index.html,data/**,tai-nguyen/**,admin/**}"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/server.js"
    }
  ]
}
