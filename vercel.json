{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/login",
      "destination": "/admin/login.html"
    },
    {
      "source": "/admin/login.html",
      "destination": "/admin/login.html"
    },
    {
      "source": "/admin.css",
      "destination": "/admin/admin.css"
    },
    {
      "source": "/admin.js",
      "destination": "/admin/admin.js"
    },
    {
      "source": "/product",
      "destination": "/product.html"
    },
    {
      "source": "/cart",
      "destination": "/cart.html"
    },
    {
      "source": "/products",
      "destination": "/products.html"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/post",
      "destination": "/post.html"
    },
    {
      "source": "/order-tracking",
      "destination": "/order-tracking.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ]
}
